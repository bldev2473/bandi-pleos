<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Vehicle SDK: 기어, 주행 가능 거리, 주행 시간(CAR_DRIVE), 배터리(CAR_ENERGY), 차량 정보(CAR_INFO) -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <!-- Pleos NaviHelper: 현재 위치, 안내 시작, 남은 시간과 도착 콜백 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- Pleos TextToSpeech -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- Pleos TextToSpeech 서버 모드 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bandi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified">
            <!-- AAOS에서 주행 중에도 화면을 띄울 수 있게 표시한다(실제 차량 배포는 심사 필요). -->
            <meta-data android:name="distractionOptimized" android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Gleo AI가 App Schema(assets/schema.json)의 함수를 부를 때 받는 인텐트 -->
            <intent-filter>
                <action android:name="SUGGEST_FESTIVAL_NOW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="CHECK_FESTIVAL_ARRIVAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="START_FESTIVAL_ROUTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
